# Ollama Cloud API Key for EDD Judge Model
# Get your key at: https://ollama.com/settings
OLLAMA_API_KEY=your_ollama_api_key_here

# Optional: Override base URL (default: https://ollama.com/v1)
# OLLAMA_BASE_URL=https://ollama.com/v1

# Optional: Override judge model (default: deepseek/deepseek-r1-0731)
# EDD_JUDGE_MODEL=deepseek/deepseek-r1-0731